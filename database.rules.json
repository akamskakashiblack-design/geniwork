{
  "rules": {
    "gw": {
      "users": {
        ".read":  false,
        ".write": "auth != null"
      },
      "users_public": {
        ".read":  true,
        ".write": false
      },
      "profiles": {
        ".read":  true,
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey",
          ".validate": "(!data.child('planType').exists() || newData.child('planType').exists()) && (!data.child('planBilling').exists() || newData.child('planBilling').exists()) && (!data.child('planSince').exists() || newData.child('planSince').exists()) && (!data.child('planCancelled').exists() || newData.child('planCancelled').exists()) && (!data.child('planCancelledAt').exists() || newData.child('planCancelledAt').exists()) && (!data.child('planRenewalDate').exists() || newData.child('planRenewalDate').exists()) && (!data.child('aiCredits').exists() || newData.child('aiCredits').exists()) && (!data.child('aiCycleMonth').exists() || newData.child('aiCycleMonth').exists()) && (!data.child('aiPlanGranted').exists() || newData.child('aiPlanGranted').exists()) && (!data.child('badgeType').exists() || newData.child('badgeType').exists()) && (!data.child('badgeStatus').exists() || newData.child('badgeStatus').exists()) && (!data.child('identityVerified').exists() || newData.child('identityVerified').exists()) && (!data.child('badgeApprovedAt').exists() || newData.child('badgeApprovedAt').exists()) && (!data.child('badgeCertifiedBy').exists() || newData.child('badgeCertifiedBy').exists()) && (!data.child('badgeCertifiedAt').exists() || newData.child('badgeCertifiedAt').exists()) && (!data.child('badgeRevokedBy').exists() || newData.child('badgeRevokedBy').exists()) && (!data.child('badgeRevokedAt').exists() || newData.child('badgeRevokedAt').exists()) && (!data.child('badgeRevokedMotif').exists() || newData.child('badgeRevokedMotif').exists()) && (!data.child('badgeSource').exists() || newData.child('badgeSource').exists())",
          "planType":          { ".validate": "newData.val() === data.val()" },
          "planBilling":       { ".validate": "newData.val() === data.val()" },
          "planSince":         { ".validate": "newData.val() === data.val()" },
          "planCancelled":     { ".validate": "newData.val() === data.val()" },
          "planCancelledAt":   { ".validate": "newData.val() === data.val()" },
          "planRenewalDate":   { ".validate": "newData.val() === data.val()" },
          "aiCredits":         { ".validate": "newData.val() === data.val()" },
          "aiCycleMonth":      { ".validate": "newData.val() === data.val()" },
          "aiPlanGranted":     { ".validate": "newData.val() === data.val()" },
          "badgeType":         { ".validate": "newData.val() === data.val()" },
          "badgeStatus":       { ".validate": "newData.val() === data.val() || newData.val() === 'pending'" },
          "identityVerified":  { ".validate": "newData.val() === data.val()" },
          "badgeApprovedAt":   { ".validate": "newData.val() === data.val()" },
          "badgeCertifiedBy":  { ".validate": "newData.val() === data.val()" },
          "badgeCertifiedAt":  { ".validate": "newData.val() === data.val()" },
          "badgeRevokedBy":    { ".validate": "newData.val() === data.val()" },
          "badgeRevokedAt":    { ".validate": "newData.val() === data.val()" },
          "badgeRevokedMotif": { ".validate": "newData.val() === data.val()" },
          "badgeSource":       { ".validate": "newData.val() === data.val()" }
        }
      },
      "dms": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": false
        }
      },
      "dm_msgs": {
        "$dmFbKey": {
          ".read":  false,
          ".write": false,
          ".indexOn": ["id", "at", "from"]
        }
      },
      "dm_meta": {
        "$dmFbKey": {
          ".read":  false,
          ".write": false
        }
      },
      "inboxes": {
        "$toFbKey": {
          ".read":  false,
          ".indexOn": ["fromEmail", "at"],
          "$fromFbKey": {
            ".write": false
          }
        }
      },
      "dm_conversations": {
        "$userFbKey": {
          ".read": false,
          "$dmFbKey": {
            ".write": false
          }
        }
      },
      "dm_user_conversations": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$conversationId": {
            ".write": "auth != null && (auth.uid === $uid || root.child('gw/dm_conversations_v2/'+$conversationId+'/participants/'+auth.uid).exists())"
          }
        }
      },
      "dm_conversations_v2": {
        "$conversationId": {
          ".read": "auth != null && data.child('participants').child(auth.uid).exists()",
          "participants": {
            "$uid": {
              ".write": "auth != null && ((!data.parent().exists() && newData.val() === true && newData.parent().child(auth.uid).exists() && root.child('gw/plans_config/messagesEnabled').val() !== false) || (data.exists() && newData.val() === data.val()))"
            }
          },
          "lastMessage": {
            ".write": "auth != null && data.parent().child('participants').child(auth.uid).exists() && newData.isString()"
          },
          "lastMessageAt": {
            ".write": "auth != null && data.parent().child('participants').child(auth.uid).exists() && newData.isNumber()"
          },
          "unread": {
            "$uid": {
              ".write": "auth != null && data.parent().parent().child('participants').child(auth.uid).exists() && data.parent().parent().child('participants').child($uid).exists() && newData.isNumber()"
            }
          }
        }
      },
      "dm_messages": {
        "$conversationId": {
          ".read": "auth != null && root.child('gw/dm_conversations_v2/'+$conversationId+'/participants/'+auth.uid).exists()",
          "$messageId": {
            ".write": "auth != null && root.child('gw/dm_conversations_v2/'+$conversationId+'/participants/'+auth.uid).exists() && !data.exists() && newData.child('senderId').val() === auth.uid && newData.hasChildren(['senderId','senderEmail','text','createdAt']) && root.child('gw/plans_config/messagesEnabled').val() !== false"
          }
        }
      },
      "group_msgs": {
        "$grpFbKey": {
          ".read": "auth != null && data.child('meta/members').child(auth.uid).exists()",
          ".write": "auth != null && !newData.exists() && data.child('meta/owner').val() === auth.uid",
          "meta": {
            ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).val() === true && root.child('gw/plans_config/messagesEnabled').val() !== false",
            "groupId": {
              ".write": "auth != null && !data.exists()"
            },
            "name": {
              ".write": "auth != null && !data.exists()"
            },
            "createdAt": {
              ".write": "auth != null && !data.exists()"
            },
            "isFreeGroup": {
              ".write": "auth != null && !data.exists()"
            },
            "owner": {
              ".write": "auth != null && (!data.exists() || newData.val() === data.val())"
            },
            "ownerEmail": {
              ".write": "auth != null && (!data.exists() || newData.val() === data.val())"
            },
            "description": {
              ".write": "auth != null && (!data.exists() || data.parent().child('owner').val() === auth.uid)"
            },
            "members": {
              "$uid": {
                ".write": "auth != null && ((!data.parent().exists() && newData.val() === true) || (!data.exists() && newData.val() === true && (data.parent().parent().child('owner').val() === auth.uid || data.parent().parent().child('admins').child(auth.uid).val() === true)) || (data.exists() && newData.val() === data.val()) || (data.exists() && !newData.exists() && $uid === auth.uid) || (data.exists() && !newData.exists() && data.parent().parent().child('owner').val() === auth.uid) || (data.exists() && !newData.exists() && data.parent().parent().child('admins').child(auth.uid).val() === true && $uid !== data.parent().parent().child('owner').val()))"
              }
            },
            "memberEmails": {
              "$uid": {
                ".write": "auth != null && ((!data.parent().exists() && newData.exists()) || (!data.exists() && newData.exists() && (data.parent().parent().child('owner').val() === auth.uid || data.parent().parent().child('admins').child(auth.uid).val() === true)) || (data.exists() && newData.val() === data.val()) || (data.exists() && !newData.exists() && ($uid === auth.uid || data.parent().parent().child('owner').val() === auth.uid || (data.parent().parent().child('admins').child(auth.uid).val() === true && $uid !== data.parent().parent().child('owner').val()))))"
              }
            },
            "admins": {
              "$uid": {
                ".write": "auth != null && data.parent().parent().child('owner').val() === auth.uid && data.parent().parent().child('members').child($uid).exists() && $uid !== auth.uid && (!newData.exists() || newData.val() === true)"
              }
            },
            "lastMessage": {
              ".write": "auth != null && root.child('gw/group_msgs/'+$grpFbKey+'/meta/members/'+auth.uid).exists()"
            },
            "lastMessageAt": {
              ".write": "auth != null && root.child('gw/group_msgs/'+$grpFbKey+'/meta/members/'+auth.uid).exists()"
            }
          },
          "lastMsg": {
            ".write": "auth != null && root.child('gw/group_msgs/'+$grpFbKey+'/meta/members/'+auth.uid).exists()"
          },
          "lastAt": {
            ".write": "auth != null && root.child('gw/group_msgs/'+$grpFbKey+'/meta/members/'+auth.uid).exists()"
          },
          "messages": {
            "$messageId": {
              ".write": "auth != null && root.child('gw/group_msgs/'+$grpFbKey+'/meta/members/'+auth.uid).exists() && !data.exists() && (($grpFbKey.matches(/^gw_grp_adhoc_/) && newData.child('senderId').val() === auth.uid && newData.hasChildren(['senderId','senderEmail','text','createdAt'])) || (!($grpFbKey.matches(/^gw_grp_adhoc_/)) && newData.hasChildren(['id','from','text','at']) && (newData.child('from').val() === 'system' || newData.child('from').val() === root.child('gw/group_msgs/'+$grpFbKey+'/meta/memberEmails/'+auth.uid).val()))) && root.child('gw/plans_config/messagesEnabled').val() !== false"
            }
          }
        }
      },
      "group_inboxes": {
        "$userFbKey": {
          ".read": "auth != null && ((!$userFbKey.matches(/^free_/) && $userFbKey === auth.uid) || $userFbKey === ('free_' + auth.uid))",
          ".write": "auth != null && ((!$userFbKey.matches(/^free_/) && $userFbKey === auth.uid) || $userFbKey === ('free_' + auth.uid))",
          "$groupId": {
            ".write": "auth != null && ((!$userFbKey.matches(/^free_/) && $userFbKey === auth.uid) || $userFbKey === ('free_' + auth.uid) || root.child('gw/group_msgs/'+$groupId+'/meta/members/'+auth.uid).exists())"
          }
        }
      },
      "group_invites": {
        "$token": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('inviterUid').val() === auth.uid && newData.child('status').val() === 'pending' && root.child('gw/group_msgs/'+newData.child('groupId').val()+'/meta/members/'+auth.uid).exists()",
          "status": {
            ".write": "auth != null && data.exists() && data.val() === 'pending' && ((newData.val() === 'declined') || (newData.val() === 'revoked' && (root.child('gw/group_msgs/'+data.parent().child('groupId').val()+'/meta/owner').val() === auth.uid || data.parent().child('inviterUid').val() === auth.uid)))"
          }
        }
      },
      "posts": {
        ".read":  true,
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey",
          "$postId": {
            ".validate": "!data.exists() ? ((newData.child('video/videoType').val() !== 'video' || root.child('gw/plans_config/videosEnabled').val() !== false) && (newData.child('video/videoType').val() !== 'short' || root.child('gw/plans_config/shortsEnabled').val() !== false)) : true"
          }
        }
      },
      "post_imgs": {
        ".read":  true,
        "$postId": {
          ".write": "auth != null"
        }
      },
      "post_videos": {
        ".read":  true,
        "$postId": {
          ".write": "auth != null && (auth.token.gw_admin === true || !$postId.matches(/^off_/))"
        }
      },
      "official_posts": {
        ".read":  true,
        ".write": "auth != null && auth.token.gw_admin === true"
      },
      "likes": {
        ".read":  true,
        "$postId": {
          "$userFbKey": {
            ".write": "auth != null && auth.uid === $userFbKey"
          }
        }
      },
      "dislikes": {
        ".read":  true,
        "$postId": {
          ".write": "auth != null"
        }
      },
      "comments": {
        ".read":  true,
        "$postId": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorFbKey').exists() && newData.child('authorFbKey').val() === auth.uid) || (data.exists() && data.child('authorFbKey').exists() && (data.child('authorFbKey').val() === auth.uid || auth.token.gw_admin === true) && (!newData.exists() || newData.child('authorFbKey').val() === data.child('authorFbKey').val())) || (data.exists() && !data.child('authorFbKey').exists() && auth.token.gw_admin === true))"
          }
        }
      },
      "rcounts": {
        ".read":  true,
        "$postId": {
          ".write": "auth != null"
        }
      },
      "creact": {
        ".read":  true,
        "$cid": {
          ".write": "auth != null"
        }
      },
      "vid_views": {
        ".read":  true,
        "$postId": {
          ".write": "auth != null"
        }
      },
      "viewed_vids": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "following": {
        ".read":  true,
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "follow_counts": {
        ".read":  true,
        "$profileFbKey": {
          ".write": "auth != null"
        }
      },
      "followers": {
        "$profileFbKey": {
          ".read":  true,
          "$followerFbKey": {
            ".write": "auth != null && auth.uid === $followerFbKey"
          }
        }
      },
      "notifs": {
        "$userFbKey": {
          ".read":  "auth != null && auth.uid === $userFbKey",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "fcm_tokens": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "mk_listings": {
        ".read":  false,
        ".write": false
      },
      "mk_listings_v2": {
        ".read": true,
        "$sellerUid": {
          ".write": "auth != null && auth.uid === $sellerUid",
          "$listingId": {
            ".validate": "newData.hasChildren(['id','sellerEmail','title','price','type','status'])",
            "id":            { ".validate": "newData.val() === $listingId" },
            "sellerEmail":   { ".validate": "!data.exists() || newData.val() === data.val()" },
            "sellerPaypal":  { ".validate": "!data.exists() || (data.val() === '' && newData.isString()) || newData.val() === data.val()" },
            "sellerPlan":    { ".validate": "newData.val() === ((root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'premium' || root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'business') ? root.child('gw/profiles/' + $sellerUid + '/planType').val() : 'free')" },
            "isPriority":    { ".validate": "newData.val() === (root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'business')" },
            "canAd":         { ".validate": "newData.val() === (root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'premium' || root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'business')" },
            "expiresAt":     { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : (newData.val() <= now + ((root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'premium' || root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'business') ? 5184000000 : 2592000000) + 60000 && newData.val() >= now + ((root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'premium' || root.child('gw/profiles/' + $sellerUid + '/planType').val() === 'business') ? 5184000000 : 2592000000) - 60000))" },
            "status":        { ".validate": "!data.exists() ? newData.val() === 'active' : (newData.val() === data.val() || newData.val() === 'sold' || (newData.val() === 'expired' && data.val() === 'active' && now >= newData.parent().child('expiresAt').val()))" }
          }
        }
      },
      "mk_txns": {
        ".read":  "auth.token.gw_admin === true",
        ".write": false
      },
      "mk_txns_v2": {
        ".read":  "auth.token.gw_admin === true",
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "collab_requests": {
        ".read":  false,
        ".write": false
      },
      "collab_requests_v2": {
        ".read":  true,
        ".write": false
      },
      "collab_request_docs_v2": {
        "$ownerUid": {
          "$requestId": {
            ".read":  "auth != null && (auth.uid === $ownerUid || root.child('gw/collab_requests_v2/'+$ownerUid+'/'+$requestId+'/applicants').child(auth.uid).exists())",
            ".write": false
          }
        }
      },
      "collab_invites": {
        "$userFbKey": {
          ".read":  "auth != null && auth.uid === $userFbKey",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "milestones": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      },
      "services": {
        ".read":  true,
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "projects": {
        ".read":  true,
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "reviews": {
        ".read":  true,
        "$profileFbKey": {
          ".write": "auth != null"
        }
      },
      "bans": {
        ".read":  "auth != null",
        ".write": false
      },
      "reports": {
        ".read":  "auth != null && auth.token.gw_admin === true",
        "$userFbKey": {
          ".write": "auth != null && (auth.uid === $userFbKey || auth.token.gw_admin === true || $userFbKey.matches(/^nsfw_/))"
        }
      },
      "blocked": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "privacy": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "admin_tasks": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "badge_requests": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "publishers": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "settings_logo": {
        ".read":  true,
        ".write": false
      },
      "settings_jobs_enabled": {
        ".read":  true,
        ".write": false
      },
      "online": {
        ".read":  "auth != null",
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "payments": {
        ".read":  "auth.token.gw_admin === true",
        ".write": false
      },
      "plans_config": {
        ".read":  true,
        ".write": false
      },
      "support_config": {
        ".read":  true,
        ".write": false
      },
      "ban_appeals": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "admin_log": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "admin_requests": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "admin_extra_perms": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "admins": {
        ".read":  "auth != null",
        ".write": false
      },
      "sadmin": {
        ".read":  "auth != null",
        ".write": false
      },
      "admin_secrets": {
        ".read":  false,
        ".write": false
      },
      "security_events": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "restrictions": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "restriction_appeals": {
        ".read":  "auth != null",
        ".write": "auth != null"
      },
      "appeal_decisions": {
        ".read":  "auth != null",
