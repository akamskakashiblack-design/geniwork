      "jobs": {
        ".read":  false,
        ".write": false
      },
      "jobs_v2": {
        ".read": true,
        "$recruiterUid": {
          ".write": "auth != null && auth.uid === $recruiterUid",
          "$jobId": {
            ".validate": "newData.hasChildren(['id','title','description','postedBy','status'])",
            "id":         { ".validate": "newData.val() === $jobId" },
            "postedBy":   { ".validate": "!data.exists() || newData.val() === data.val()" },
            "status":     { ".validate": "!data.exists() ? newData.val() === 'active' : (newData.val() === data.val() || newData.val() === 'closed')" },
            "applicants": { ".validate": false }
          }
        }
      },
      "recruiter_verifs": {
        ".read":  false,
        ".write": false
      },
      "recruiter_verifs_v2": {
        "$applicantUid": {
          ".read":  "auth != null && auth.uid === $applicantUid",
          ".write": "auth != null && auth.uid === $applicantUid",
          "$verifId": {
            ".validate": "newData.hasChildren(['id','email','company','regnum','status','submittedAt'])",
            "id":            { ".validate": "!data.exists() || newData.val() === data.val()" },
            "email":         { ".validate": "!data.exists() || newData.val() === data.val()" },
            "status":        { ".validate": "!data.exists() ? newData.val() === 'pending' : newData.val() === data.val()" },
            "reviewedAt":    { ".validate": "!data.exists() || newData.val() === data.val()" },
            "reviewedBy":    { ".validate": "!data.exists() || newData.val() === data.val()" },
            "rejectReason":  { ".validate": "!data.exists() || newData.val() === data.val()" }
          }
        }
      },
      "job_applications": {
        ".read":  false,
        ".write": false
      },
      "job_applications_v2": {
        "$jobOwnerUid": {
          ".read":  "auth != null && auth.uid === $jobOwnerUid",
          ".write": "auth != null && auth.uid === $jobOwnerUid",
          "$applicationId": {
            ".validate": "newData.hasChildren(['id','jobId','candidateUid','applicantEmail','appliedAt','archived','mode']) && (newData.child('mode').val() !== 'simplified' || newData.hasChildren(['cv','phone']))",
            "id":            { ".validate": "!data.exists() || newData.val() === data.val()" },
            "jobId":         { ".validate": "!data.exists() || newData.val() === data.val()" },
            "candidateUid":  { ".validate": "!data.exists() || newData.val() === data.val()" },
            "applicantEmail":{ ".validate": "!data.exists() || newData.val() === data.val()" },
            "applicantNom":  { ".validate": "!data.exists() || newData.val() === data.val()" },
            "cv":            { ".validate": "!data.exists() || newData.val() === data.val()" },
            "phone":         { ".validate": "!data.exists() || newData.val() === data.val()" },
            "motivation":    { ".validate": "!data.exists() || newData.val() === data.val()" },
            "mode":          { ".validate": "!data.exists() || newData.val() === data.val()" },
            "appliedAt":     { ".validate": "!data.exists() || newData.val() === data.val()" },
            "status":        { ".validate": false },
            "archived":      { ".validate": "newData.isBoolean()" }
          }
        }
      },
      "candidate_applications": {
        "$candidateUid": {
          ".read":  "auth != null && auth.uid === $candidateUid",
          ".write": false
        }
      },
      "job_saved": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "job_hist_hidden": {
        "$userFbKey": {
          ".read":  "auth != null",
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "recruiter_logos": {
        ".read":  true,
        ".write": "auth != null"
      },
      "ebook_access": {
        "$listingId": {
          ".read":  "auth != null",
          ".write": "auth != null"
        }
      },
      "mk_listing_stats": {
        ".read":  true,
        "$listingId": {
          ".write": "auth != null"
        }
      },
      "hashtags": {
        ".read":  true,
        ".write": "auth != null"
      }
    },
    "gw_system": {
      "reset_at": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
