        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('gwr_admin/accounts/'+auth.uid+'/role').val() === 'super_admin' && root.child('gwr_admin/accounts/'+auth.uid+'/status').val() === 'approved'))",
          ".write": "auth != null && (auth.uid === $uid || (root.child('gwr_admin/accounts/'+auth.uid+'/role').val() === 'super_admin' && root.child('gwr_admin/accounts/'+auth.uid+'/status').val() === 'approved'))"
        }
      }
    }
  }
}
