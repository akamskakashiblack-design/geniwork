      },
      "settings_jobs_enabled": {
        ".read":  true,
        ".write": false
      },
      "online": {
        ".read":  "auth != null",
        "$userFbKey": {
          ".write": "auth != null && auth.uid === $userFbKey"
        }
      },
      "payments": {
        ".read":  "auth != null",
